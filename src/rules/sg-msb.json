{
  "module": "sg-msb",
  "version": "2026.07.1",
  "updated_at": "2026-07-24T00:00:00Z",
  "rules": [
    {
      "id": "sg-psa-licence-class",
      "when": {
        "activity": ["money_transmission", "stored_value", "crypto_transfer"],
        "party_country": "SG",
        "monthly_volume_gte": 2320903.605137
      },
      "required_evidence": ["mas_major_payment_institution_licence"],
      "result_if_missing": "HOLD",
      "always_escalate": false,
      "source": "Payment Services Act 2019, section 6",
      "source_url": "https://sso.agc.gov.sg/Act/PSA2019",
      "accessed_date": "2026-07-23",
      "note": "法源对单一相关支付服务采用月均 S$3M 门槛，两项以上合计采用 S$6M；本规则按 2026-07-23 的 1 USD=1.2926 SGD、USDC≈USD 固定换算单项门槛为 2,320,903.605137 USDC。输入不含多服务合计维度，S$6M 路径需人工核实"
    },
    {
      "id": "sg-mas-register-lookup",
      "when": {
        "activity": ["money_transmission", "currency_exchange", "stored_value", "crypto_transfer"],
        "party_country": "SG"
      },
      "required_evidence": ["mas_financial_institution_directory_entry"],
      "result_if_missing": "HOLD",
      "always_escalate": false,
      "source": "MAS Financial Institutions Directory",
      "source_url": "https://eservices.mas.gov.sg/fid",
      "accessed_date": "2026-07-23",
      "note": "PASS 仅表示已提交 MAS 金融机构名录登记证据；登记存在不等于本次活动必然在获准服务范围内"
    },
    {
      "id": "sg-psn01-aml-program",
      "when": {
        "activity": ["money_transmission", "currency_exchange", "stored_value"],
        "party_country": "SG"
      },
      "required_evidence": ["mas_psn01_aml_cft_program"],
      "result_if_missing": "HOLD",
      "always_escalate": false,
      "source": "MAS Notice PSN01",
      "source_url": "https://www.mas.gov.sg/regulation/notices",
      "accessed_date": "2026-07-23",
      "note": "PSN01 适用于指定支付服务的 AML/CFT 控制；MAS 具体 Notice 页面 URL 无法稳定解析，暂用 MAS Notices 官方入口，待 CI 链接检查核实具体直达页"
    },
    {
      "id": "sg-psn02-dpt-aml-program",
      "when": {
        "activity": ["crypto_transfer"],
        "party_country": "SG"
      },
      "required_evidence": ["mas_psn02_dpt_aml_cft_program"],
      "result_if_missing": "HOLD",
      "always_escalate": false,
      "source": "MAS Notice PSN02",
      "source_url": "https://www.mas.gov.sg/regulation/notices",
      "accessed_date": "2026-07-23",
      "note": "PSN02 适用于数字支付代币服务的 AML/CFT 控制；MAS 具体 Notice 页面 URL 无法稳定解析，暂用 MAS Notices 官方入口，待 CI 链接检查核实具体直达页"
    },
    {
      "id": "sg-dpt-scope",
      "when": {
        "activity": ["crypto_transfer"],
        "party_country": "SG"
      },
      "required_evidence": [],
      "result_if_missing": "ESCALATE",
      "always_escalate": true,
      "source": "Payment Services (Amendment) Act 2021",
      "source_url": "https://sso.agc.gov.sg/Acts-Supp/1-2021/Published/20210301?DocDate=20210301",
      "accessed_date": "2026-07-23",
      "note": "2021 修正案自 2024-04-04 起施行并扩展 DPT 服务范围；现有 activity 无法表达代币账户、托管、转移安排、境内外服务对象及过渡豁免，必须转人工核实"
    }
  ]
}
